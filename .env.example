# Copy to .env and fill in. Never commit .env.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai

# optional: TYPESAFE_API_KEY=            # alternate API-key variable (same resolution order as JEV_API_KEY)
# optional: JEV_MODEL=jev-latest         # default model when JevClient/AsyncJevClient get model=None (their default)
# optional: TYPESAFE_DEFAULT_MODEL=      # alternate spelling of JEV_MODEL
# optional: TYPESAFE_BASE_URL=           # alternate spelling of JEV_BASE_URL
# optional: JEV_MAX_ATTEMPTS=3           # max attempts incl. the initial request (int >= 1)
# optional: JEV_BACKOFF_BASE=0.5         # base backoff delay in seconds (float > 0)
# optional: JEV_BACKOFF_MAX=8.0          # backoff cap in seconds
# optional: JEV_JITTER=0.1               # uniform +/- jitter on the delay (float >= 0)
# optional: JEV_TIMEOUT=                 # default request timeout in seconds (positive float; unset: explicit 60.0 s)
