\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Package layer diagram for daf-jev. The CLI (\breaktt {src/daf\_jev/cli.py}) and the thin orchestration scripts (\texttt {scripts/}, \texttt {benchmarks/}) sit on the application layer; \texttt {compose.py} (pure decision patterns) and \texttt {primitives.py} (typed question builders and \texttt {QuestionSet}) form the logic layer over the wire dataclasses in \texttt {\_types.py}; \texttt {client.py} and \texttt {\_http.py} own the single transport to the System One endpoint, with \texttt {\_retry.py} and \texttt {\_errors.py} providing the pure retry policy and the typed exception hierarchy; \texttt {models.py}, \texttt {config.py}, and \texttt {evaluate.py} enter as side inputs and the batch harness respectively. Boxes are named modules only; no measured values appear in the diagram.}}{6}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{6}{Package layer diagram for daf-jev. The CLI (\protect \breaktt {src/daf\_jev/cli.py}) and the thin orchestration scripts (\protect \texttt {scripts/}, \protect \texttt {benchmarks/}) sit on the application layer; \protect \texttt {compose.py} (pure decision patterns) and \protect \texttt {primitives.py} (typed question builders and \protect \texttt {QuestionSet}) form the logic layer over the wire dataclasses in \protect \texttt {\_types.py}; \protect \texttt {client.py} and \protect \texttt {\_http.py} own the single transport to the System One endpoint, with \protect \texttt {\_retry.py} and \protect \texttt {\_errors.py} providing the pure retry policy and the typed exception hierarchy; \protect \texttt {models.py}, \protect \texttt {config.py}, and \protect \texttt {evaluate.py} enter as side inputs and the batch harness respectively. Boxes are named modules only; no measured values appear in the diagram}{figure.caption.2}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][6][]6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Layered architecture}{6}{subsection.4.1}\protected@file@percent }
\newlabel{layered-architecture}{{4.1}{6}{Layered architecture}{subsection.4.1}{}}
\newlabel{layered-architecture@cref}{{[subsection][1][4]4.1}{[1][6][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The three question primitives of the System One surface and the typed answer shapes daf-jev parses them into. A \texttt {noul} question yields a calibrated yes/no probability; a \texttt {choice} question yields a selected label, a full probability distribution over the named options, and a scalar confidence; a \texttt {score} question yields a probability-weighted score over ordered levels together with the level legend, the level distribution, and a confidence. The diagram is a schematic of shapes only --- it carries no measured data.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:primitives}{{2}{7}{The three question primitives of the System One surface and the typed answer shapes daf-jev parses them into. A \protect \texttt {noul} question yields a calibrated yes/no probability; a \protect \texttt {choice} question yields a selected label, a full probability distribution over the named options, and a scalar confidence; a \protect \texttt {score} question yields a probability-weighted score over ordered levels together with the level legend, the level distribution, and a confidence. The diagram is a schematic of shapes only --- it carries no measured data}{figure.caption.3}{}}
\newlabel{fig:primitives@cref}{{[figure][2][]2}{[1][6][]7}{}{}{}}
