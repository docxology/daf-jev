\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Decision-pipeline latency}{12}{subsection.6.2}\protected@file@percent }
\newlabel{decision-pipeline-latency}{{6.2}{12}{Decision-pipeline latency}{subsection.6.2}{}}
\newlabel{decision-pipeline-latency@cref}{{[subsection][2][6]6.2}{[1][12][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Median (p50) and tail (p95) end-to-end wall time per decision pipeline, measured by \breaktt {benchmarks/bench\_patterns.py} over 6 runs against the jev-latest model on 2026-09-16. Each pipeline group --- composite scoring (one \texttt {score} call, then \texttt {composite\_score} and a \texttt {confidence\_gate} verdict) and intent routing (one \texttt {choice} call, then \texttt {route()} dispatch) --- shows paired p50/p95 bars covering the full network round trip plus the local composition logic; values are tabulated in tbl.~\ref {tbl:latency} and read from the benchmark JSON fields at figure-generation time. The takeaway: both pipelines sit within the model's millisecond-scale latency envelope, so the pure-logic composition layer adds no measurable latency beyond the network round trip and the gating policy can run inline on interactive request paths.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:latency}{{6}{12}{Median (p50) and tail (p95) end-to-end wall time per decision pipeline, measured by \protect \breaktt {benchmarks/bench\_patterns.py} over 6 runs against the jev-latest model on 2026-09-16. Each pipeline group --- composite scoring (one \protect \texttt {score} call, then \protect \texttt {composite\_score} and a \protect \texttt {confidence\_gate} verdict) and intent routing (one \protect \texttt {choice} call, then \protect \texttt {route()} dispatch) --- shows paired p50/p95 bars covering the full network round trip plus the local composition logic; values are tabulated in tbl.~\ref {tbl:latency} and read from the benchmark JSON fields at figure-generation time. The takeaway: both pipelines sit within the model's millisecond-scale latency envelope, so the pure-logic composition layer adds no measurable latency beyond the network round trip and the gating policy can run inline on interactive request paths}{figure.caption.7}{}}
\newlabel{fig:latency@cref}{{[figure][6][]6}{[1][12][]12}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces End-to-end wall time (network round trip plus local composition logic) per decision pipeline, median and tail over 6 runs recorded by \breaktt {benchmarks/bench\_patterns.py} against the jev-latest model on 2026-09-16. Values are injected from the benchmark JSON at render time.}}{12}{table.2}\protected@file@percent }
\newlabel{tbl:latency}{{2}{12}{End-to-end wall time (network round trip plus local composition logic) per decision pipeline, median and tail over 6 runs recorded by \protect \breaktt {benchmarks/bench\_patterns.py} against the jev-latest model on 2026-09-16. Values are injected from the benchmark JSON at render time}{table.2}{}}
\newlabel{tbl:latency@cref}{{[table][2][]2}{[1][12][]12}{}{}{}}
