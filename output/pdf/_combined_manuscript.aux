\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Batching speedup of the jev-latest model versus sequential single-question calls, measured by \breaktt {benchmarks/bench\_batching.py} on 2026-09-16. Bars give the wall-time speedup of one batched call over one sequential call per question for each configured batch width (5, 10, 20 questions, values in tbl.~\ref {tbl:batching}); the secondary axis shows the token-cost ratio, which falls below unity because the sequential strategy re-sends the state once per question. Bars are annotated with their values; the title in the rendered figure carries the model and run date read from the benchmark JSON itself.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:batching}{{4}{10}{Batching speedup of the jev-latest model versus sequential single-question calls, measured by \protect \breaktt {benchmarks/bench\_batching.py} on 2026-09-16. Bars give the wall-time speedup of one batched call over one sequential call per question for each configured batch width (5, 10, 20 questions, values in tbl.~\ref {tbl:batching}); the secondary axis shows the token-cost ratio, which falls below unity because the sequential strategy re-sends the state once per question. Bars are annotated with their values; the title in the rendered figure carries the model and run date read from the benchmark JSON itself}{figure.caption.5}{}}
\newlabel{fig:batching@cref}{{[figure][4][]4}{[1][10][]10}{}{}{}}
