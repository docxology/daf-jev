\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Parametric illustration of confidence-gated routing as implemented by \breaktt {confidence\_gate()} and \texttt {route()} in \breaktt {src/daf\_jev/compose.py}. The horizontal axis is the model-reported confidence on the unit interval; the three horizontal bands assign an action per confidence region --- automate, review, escalate. The boundary markers are annotated as example thresholds: they illustrate the band semantics and are not fitted or recommended values.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:confidence}{{3}{8}{Parametric illustration of confidence-gated routing as implemented by \protect \breaktt {confidence\_gate()} and \protect \texttt {route()} in \protect \breaktt {src/daf\_jev/compose.py}. The horizontal axis is the model-reported confidence on the unit interval; the three horizontal bands assign an action per confidence region --- automate, review, escalate. The boundary markers are annotated as example thresholds: they illustrate the band semantics and are not fitted or recommended values}{figure.caption.4}{}}
\newlabel{fig:confidence@cref}{{[figure][3][]3}{[1][8][]8}{}{}{}}
