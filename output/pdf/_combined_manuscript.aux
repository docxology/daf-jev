\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Typed primitives}{7}{subsection.4.2}\protected@file@percent }
\newlabel{typed-primitives}{{4.2}{7}{Typed primitives}{subsection.4.2}{}}
\newlabel{typed-primitives@cref}{{[subsection][2][4]4.2}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The three question primitives of the System One surface and the typed answer shapes daf-jev parses them into, drawn as a schematic of the wire contract (sec.~\ref {sec:jev_model}). A \texttt {noul} question yields a calibrated yes/no probability; a \texttt {choice} question yields a selected label, a full probability distribution over the named options, and a scalar confidence; a \texttt {score} question yields a probability-weighted score over ordered levels together with the level legend, the level distribution, and a confidence. The takeaway is that the builders in \texttt {primitives.py} map one-to-one onto these shapes with strict, eager validation --- score criteria must carry at least two ordered levels, choice criteria must be non-empty, and the answer-side parser rejects any payload outside the discriminated union --- so downstream composition code can pattern-match on answers without defensive parsing. The diagram carries no measured data.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:primitives}{{3}{7}{The three question primitives of the System One surface and the typed answer shapes daf-jev parses them into, drawn as a schematic of the wire contract (sec.~\ref {sec:jev_model}). A \protect \texttt {noul} question yields a calibrated yes/no probability; a \protect \texttt {choice} question yields a selected label, a full probability distribution over the named options, and a scalar confidence; a \protect \texttt {score} question yields a probability-weighted score over ordered levels together with the level legend, the level distribution, and a confidence. The takeaway is that the builders in \protect \texttt {primitives.py} map one-to-one onto these shapes with strict, eager validation --- score criteria must carry at least two ordered levels, choice criteria must be non-empty, and the answer-side parser rejects any payload outside the discriminated union --- so downstream composition code can pattern-match on answers without defensive parsing. The diagram carries no measured data}{figure.caption.4}{}}
\newlabel{fig:primitives@cref}{{[figure][3][]3}{[1][6][]7}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Composable decision patterns}{7}{subsection.4.3}\protected@file@percent }
\newlabel{composable-decision-patterns}{{4.3}{7}{Composable decision patterns}{subsection.4.3}{}}
\newlabel{composable-decision-patterns@cref}{{[subsection][3][4]4.3}{[1][7][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Parametric illustration of confidence-gated routing as implemented by \breaktt {confidence\_gate()} and \texttt {route()} in \breaktt {src/daf\_jev/compose.py} (sec.~\ref {sec:methodology}). The horizontal axis is the model-reported confidence on the unit interval; the three horizontal bands assign an action per confidence region --- automate above the upper boundary, route to review in the middle band, escalate below the lower boundary. The boundary markers are annotated as example thresholds: the semantics are the bands, not any particular cut points, and the actual thresholds remain policy owned by the caller. This figure is parametric and carries no measured data; sec.~\ref {sec:results} measures the latency and calibration properties that make running this policy inline sound.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:confidence}{{4}{8}{Parametric illustration of confidence-gated routing as implemented by \protect \breaktt {confidence\_gate()} and \protect \texttt {route()} in \protect \breaktt {src/daf\_jev/compose.py} (sec.~\ref {sec:methodology}). The horizontal axis is the model-reported confidence on the unit interval; the three horizontal bands assign an action per confidence region --- automate above the upper boundary, route to review in the middle band, escalate below the lower boundary. The boundary markers are annotated as example thresholds: the semantics are the bands, not any particular cut points, and the actual thresholds remain policy owned by the caller. This figure is parametric and carries no measured data; sec.~\ref {sec:results} measures the latency and calibration properties that make running this policy inline sound}{figure.caption.5}{}}
\newlabel{fig:confidence@cref}{{[figure][4][]4}{[1][7][]8}{}{}{}}
